# Connector: python -m puente <command> reads these (a local .env file works too).
PUENTE_SAAS_URL=http://localhost:8000
PUENTE_CLIENT_ID=puente-dev
PUENTE_CLIENT_SECRET=dev-secret
PUENTE_STATE_DB=state/puente.db
PUENTE_LOG_FILE=logs/puente.jsonl
PUENTE_BATCH_SIZE=100
PUENTE_TIMEOUT_S=2
PUENTE_MAX_ATTEMPTS=6
PUENTE_MAX_ELAPSED_S=30

# Mock SaaS: read from the real environment (docker compose sets them for you).
# MOCK_CLIENT_ID=puente-dev
# MOCK_CLIENT_SECRET=dev-secret
# MOCK_TOKEN_TTL_SECONDS=300
# MOCK_RATE_LIMIT_CAPACITY=20
