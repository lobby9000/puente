# Connector: python -m puente <command> reads these (a local .env file works too).
PUENTE_SAAS_URL=http://localhost:8000
PUENTE_CLIENT_ID=puente-dev
PUENTE_CLIENT_SECRET=dev-secret
PUENTE_STATE_DB=state/puente.db
PUENTE_LOG_FILE=logs/puente.jsonl
PUENTE_BATCH_SIZE=100
PUENTE_TIMEOUT_S=2
PUENTE_MAX_ATTEMPTS=6
PUENTE_MAX_ELAPSED_S=30

# Databricks (stage 2). Never commit the real values: .env is in .gitignore.
# Host and HTTP path: SQL Warehouses > Serverless Starter Warehouse > Connection details.
# Token: your user menu > Settings > Developer > Access tokens > Generate new token.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
PUENTE_DATABRICKS_TABLE=workspace.puente.gold_vendor_commissions

# Zoho CRM (stage 3). Client ID and secret: api-console.zoho.com > your Self Client > Client Secret.
# Leave ZOHO_REFRESH_TOKEN empty: python -m puente zoho auth writes it, with ZOHO_API_DOMAIN.
# Never commit the real values, and never paste them in a chat.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=
PUENTE_ZOHO_CREDIT_BUDGET=500
PUENTE_ZOHO_CREDIT_RESERVE=1000
# Where rep-to-payee mappings come from: destination (stages 1 and 2) or zoho.
PUENTE_PAYEES=destination

# Mock SaaS: read from the real environment (docker compose sets them for you).
# MOCK_CLIENT_ID=puente-dev
# MOCK_CLIENT_SECRET=dev-secret
# MOCK_TOKEN_TTL_SECONDS=300
# MOCK_RATE_LIMIT_CAPACITY=20
# MOCK_RATE_LIMIT_REFILL_PER_S=10
